[Unit]
Description=DAOS Zeus Shared Memory GPT Action Adapter
After=network-online.target daos-memory.service
Wants=network-online.target
Requires=daos-memory.service

[Service]
Type=simple
User=daos-memory
Group=daos-memory
WorkingDirectory=/opt/daos-memory/current
Environment=PYTHONPATH=/opt/daos-memory/current
Environment=DAOS_MEMORY_ACTION_TOKEN_FILE=/etc/daos-memory/zeus-action.token
Environment=DAOS_MEMORY_UPSTREAM_URL=http://172.18.0.1:8791
Environment=DAOS_MEMORY_ACTION_HOST=172.18.0.1
Environment=DAOS_MEMORY_ACTION_PORT=8793
# Permit only the current NPM container on the existing dominof-network bridge.
ExecStartPre=+/bin/sh -c '/usr/sbin/iptables -C INPUT -i br-a0bd2b780836 -s 172.18.0.4/32 -d 172.18.0.1 -p tcp --dport 8793 -j ACCEPT 2>/dev/null || /usr/sbin/iptables -I INPUT 5 -i br-a0bd2b780836 -s 172.18.0.4/32 -d 172.18.0.1 -p tcp --dport 8793 -j ACCEPT'
ExecStart=/opt/daos-memory/current/venv/bin/python -m plugins.daos_memory.action_api
ExecStopPost=+/bin/sh -c '/usr/sbin/iptables -C INPUT -i br-a0bd2b780836 -s 172.18.0.4/32 -d 172.18.0.1 -p tcp --dport 8793 -j ACCEPT 2>/dev/null && /usr/sbin/iptables -D INPUT -i br-a0bd2b780836 -s 172.18.0.4/32 -d 172.18.0.1 -p tcp --dport 8793 -j ACCEPT || true'
Restart=on-failure
RestartSec=5s
TimeoutStartSec=30s
TimeoutStopSec=20s
MemoryMax=128M
TasksMax=64
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target

[Unit]
Description=Renew the dedicated DAOS Memory Action TLS certificate
After=docker.service network-online.target
Requires=docker.service
ConditionPathExists=/opt/dominof/proxy/letsencrypt/renewal/npm-memory.conf

[Service]
Type=oneshot
User=root
ExecStart=/usr/bin/docker exec dominof-nginx-proxy-manager certbot renew --cert-name npm-memory --quiet --deploy-hook "nginx -s reload"
TimeoutStartSec=10min
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
RestrictAddressFamilies=AF_UNIX
LockPersonality=true

[Install]
WantedBy=multi-user.target
